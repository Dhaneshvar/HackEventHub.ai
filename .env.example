# === Telegram ===
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# === Dashboard ===
DASHBOARD_TOKEN=generate-a-secure-random-token

# === TinyFish ===
TINYFISH_API_KEY=your-tinyfish-api-key

# === LLM: Ollama (local) ===
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# === LLM: Azure OpenAI ===
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_KEY=your-azure-api-key
# For Entra ID auth (alternative to API key):
# AZURE_USE_ENTRA_ID=true

# === LLM: Unisys Athena EA ===
ATHENA_BASE_URL=https://athena.example.com/api
ATHENA_API_KEY=your-athena-api-key
ATHENA_MODEL=default
ATHENA_AUTH_HEADER=Authorization
ATHENA_AUTH_SCHEME=Bearer

# === General ===
CONTACT_EMAIL=your-email@example.com
TZ=UTC

# === TinyFish Budget ===
TINYFISH_DAILY_BUDGET_AGENT=10
TINYFISH_DAILY_BUDGET_FETCH=100

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./data/opportunity_agent.db
